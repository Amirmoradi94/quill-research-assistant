{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quill AI",
  "version": "0.1.10",
  "identifier": "local.quill.researchassistant",
  "build": {
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run bundle",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Quill AI",
        "width": 1440,
        "height": 940,
        "minWidth": 1100,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/postdoc-backend",
      "binaries/postdoc-scraper"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI2MzY0ODdCNzE0REFEQTUKUldTbHJVMXhlMGcySnRFTThQQnNoY0sxZldqdWpLU1hrNEE5elZrR2R6MDFUU1dtQ2prUi81cG4K",
      "endpoints": [
        "https://github.com/Amirmoradi94/quill-research-assistant/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
